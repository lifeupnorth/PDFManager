<Window x:Class="PDFManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFManager.ViewModels"
        xmlns:local="clr-namespace:PDFManager"
        mc:Ignorable="d"
        Title="PDF Manager" Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        Icon="app.ico">
    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
        <local:StringVisibilityConverter x:Key="EmptyToVisibility" VisibleWhenEmpty="True"/>
        <local:StringVisibilityConverter x:Key="NotEmptyToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Path label: single line, trimmed with an ellipsis -->
        <Style x:Key="PathLabel" TargetType="Label" BasedOn="{StaticResource ValueLabel}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row template for a file in the merge list -->
        <DataTemplate x:Key="MergeFileTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{StaticResource FileTileBrush}" Width="38" Height="38" Margin="0,0,14,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{StaticResource OrganizeIconBrush}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FileName}" Text="{Binding Converter={StaticResource FileNameConverter}}"/>
                    <TextBlock Style="{StaticResource FilePath}" Text="{Binding}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26,30,30">
                    <TextBlock Text="Tools" Style="{StaticResource PageHeading}"/>

                    <TextBlock Text="Organize PDF" Style="{StaticResource CategoryHeading}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="2" Click="OpenTool_Click" AutomationProperties.Name="Merge PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{StaticResource OrganizeTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconMerge}" Stroke="{StaticResource OrganizeIconBrush}"/>
                                </Border>
                                <TextBlock Text="Merge PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="1" Click="OpenTool_Click" AutomationProperties.Name="Split PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{StaticResource OrganizeTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconSplit}" Stroke="{StaticResource OrganizeIconBrush}"/>
                                </Border>
                                <TextBlock Text="Split PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Edit PDF" Style="{StaticResource CategoryHeading}" Margin="0,34,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="3" Click="OpenTool_Click" AutomationProperties.Name="Rotate PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{StaticResource EditTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRotate}" Stroke="{StaticResource EditIconBrush}"/>
                                </Border>
                                <TextBlock Text="Rotate PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SplitViewModel}">
            <Grid Background="{StaticResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="splitTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Split PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Separate a document into two files after the page you choose." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="SELECTED FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{StaticResource FileTileBrush}" Width="40" Height="40" Margin="0,0,14,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{StaticResource OrganizeIconBrush}" Width="19" Height="19" Stretch="Uniform" StrokeThickness="2"/>
                                </Border>
                                <Button DockPanel.Dock="Right" Content="Change file" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding OpenFileCommand}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource FileNameConverter}}"/>
                                    <Label Style="{StaticResource PathLabel}" Content="{Binding SourcePath}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Drop another PDF anywhere on this page to replace it." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Button Command="{Binding RunSplitCommand}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Split PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Splitting..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Split PDF" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="SPLIT AFTER PAGE" Style="{StaticResource SectionLabel}"/>
                                <TextBox Text="{Binding SplitPageNum, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="110" HorizontalAlignment="Left"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>

                                <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputFolder}" Style="{StaticResource ValueLabel}"/>
                                <Label Style="{StaticResource HintLabel}" Content="Two files named after the source, ending in _part1 and _part2, are saved next to it."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MergeViewModel}">
            <Grid Background="{StaticResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="mergeTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding HasItems, ElementName=lstMergeFiles, Converter={StaticResource InverseBoolToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Merge PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Combine several PDFs into a single document, in the order you want." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding AddFilesCommand}" Content="Select PDF files" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop PDFs here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Visibility="{Binding HasItems, ElementName=lstMergeFiles, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Add files" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}"/>
                            <TextBlock Text="FILES TO MERGE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Files are merged top to bottom. Drop more PDFs anywhere on this page to add them." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,4,0,0"/>
                        <ListBox x:Name="lstMergeFiles" ItemsSource="{Binding MergeFiles}" SelectionMode="Extended" Style="{StaticResource FileList}" ItemTemplate="{StaticResource MergeFileTemplate}"/>
                    </DockPanel>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Button Command="{Binding RunMergeCommand}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Merge PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Merging..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Merge PDF" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="ORDER" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstMergeFiles}" Content="Move up" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                    <Button Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstMergeFiles}" Content="Move down" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <Button Command="{Binding RemoveFileCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstMergeFiles}" Content="Remove selected" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                                <Label Style="{StaticResource HintLabel}" Content="Select a file in the list to reorder or remove it."/>

                                <TextBlock Text="OUTPUT FILE" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RotateViewModel}">
            <Grid Background="{StaticResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="rotateTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Rotate PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Rotate all pages, or only the ones you pick, and save a new copy." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="SELECTED FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{StaticResource EditTileBrush}" Width="40" Height="40" Margin="0,0,14,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{StaticResource EditIconBrush}" Width="19" Height="19" Stretch="Uniform" StrokeThickness="2"/>
                                </Border>
                                <Button DockPanel.Dock="Right" Content="Change file" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding OpenFileCommand}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource FileNameConverter}}"/>
                                    <Label Style="{StaticResource PathLabel}" Content="{Binding SourcePath}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Drop another PDF anywhere on this page to replace it." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Button Command="{Binding RunRotateCommand}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Rotate PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Rotating..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Rotate PDF" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="PAGES TO ROTATE" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="All pages" IsChecked="{Binding RotateAllPages}" Style="{StaticResource OptionRadio}" GroupName="RotatePages" Margin="0,0,4,8"/>
                                    <RadioButton Content="Specific pages" Style="{StaticResource OptionRadio}" GroupName="RotatePages" Margin="4,0,0,8"/>
                                </UniformGrid>
                                <TextBox Text="{Binding RotatePageSpec, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPageSpecVisible}" Style="{StaticResource Input}" ToolTip="Example: 1, 3, 5-7"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>

                                <TextBlock Text="ROTATION" Style="{StaticResource SectionLabel}"/>
                                <ComboBox SelectedValue="{Binding RotationAngle}" SelectedValuePath="Content" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="90"/>
                                    <ComboBoxItem Content="180"/>
                                    <ComboBoxItem Content="270"/>
                                </ComboBox>

                                <TextBlock Text="OUTPUT FILE" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,22">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Width="13" Height="15" Stretch="Uniform" Stroke="White" StrokeThickness="2"/>
                    </Border>
                    <TextBlock Text="PDF Manager" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="Files never leave this computer." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="22,0,22,20" TextWrapping="Wrap"/>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="navHome" AutomationProperties.Name="Tools" Style="{StaticResource NavItem}" GroupName="Nav" Tag="0" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconHome}"/>
                            <TextBlock Text="Tools" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="ORGANIZE" Style="{StaticResource SectionLabel}" Margin="22,22,0,6"/>
                    <RadioButton x:Name="navMerge" AutomationProperties.Name="Merge PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="2" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconMerge}"/>
                            <TextBlock Text="Merge PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navSplit" AutomationProperties.Name="Split PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="1" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconSplit}"/>
                            <TextBlock Text="Split PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="EDIT" Style="{StaticResource SectionLabel}" Margin="22,18,0,6"/>
                    <RadioButton x:Name="navRotate" AutomationProperties.Name="Rotate PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="3" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconRotate}"/>
                            <TextBlock Text="Rotate PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shows the selected tool; the view comes from the DataTemplate for its view model -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Focusable="False"/>
    </Grid>
</Window>