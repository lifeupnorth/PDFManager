<Window x:Class="PDFManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDFManager"
        mc:Ignorable="d"
        Title="PDF Manager" Height="450" Width="800"
        Icon="app.ico">
    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="tabControl">
            <TabItem Header="Split PDF">
                <Grid Background="#FFE5E5E5" AllowDrop="True" DragOver="tab_DragOver" Drop="splitTab_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Source File" Margin="26,12,0,2"/>
                    <DockPanel Grid.Row="1" Margin="26,0,26,0">
                        <Button x:Name="btnOpenFileSplit" Content="Select" DockPanel.Dock="Right" Width="72" Height="26" Margin="6,0,0,0" Click="openFileSplit_Click"/>
                        <Label x:Name="lblSplitFileSource" Content="No file selected" Background="White" BorderBrush="#FFABADB3" BorderThickness="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" AllowDrop="True"/>
                    </DockPanel>

                    <Label Grid.Row="2" Content="Split After Page" Margin="26,12,0,2"/>
                    <Grid Grid.Row="3" Margin="26,0,26,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSplitPageNum" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                        <Label x:Name="lblSplitPageCount" Grid.Column="1" Content="" VerticalContentAlignment="Center" Foreground="Gray" Margin="8,0,0,0" Padding="0"/>
                    </Grid>

                    <Label Grid.Row="4" Content="Output Folder" Margin="26,12,0,2"/>
                    <Label x:Name="lblSplitOutputFolder" Grid.Row="5" Content="" Background="White" BorderBrush="#FFABADB3" BorderThickness="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" Margin="26,0,26,0" VerticalAlignment="Top"/>

                    <Button x:Name="btnRunSplit" Grid.Row="6" Content="Split" HorizontalAlignment="Center" Margin="0,0,0,16" Height="37" Width="84" Click="btnRunSplit_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Merge PDF">
                <Grid Background="#FFE5E5E5" AllowDrop="True" DragOver="tab_DragOver" Drop="mergeTab_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Files To Merge" Margin="26,8,0,0"/>
                    <ListBox x:Name="lstMergeFiles" Grid.Row="1" Margin="26,0,26,8" AllowDrop="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ToolTip" Value="{Binding}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Row="2" Margin="26,0,26,8">
                        <Label Content="Output File:" DockPanel.Dock="Left" Height="26" VerticalContentAlignment="Center" Padding="0,0,6,0"/>
                        <Button x:Name="btnBrowseMergeOutput" Content="Browse" DockPanel.Dock="Right" Width="72" Height="26" Margin="6,0,0,0" Click="btnBrowseMergeOutput_Click"/>
                        <Label x:Name="lblMergeOutput" Content="" Background="White" BorderBrush="#FFABADB3" BorderThickness="1" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                    </DockPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Button x:Name="btnAddFileMerge" Content="Add File" Width="84" Height="37" Margin="6,0" Click="btnAddFileMerge_Click"/>
                        <Button x:Name="btnRemoveFileMerge" Content="Remove" Width="84" Height="37" Margin="6,0" Click="btnRemoveFileMerge_Click" IsEnabled="False"/>
                        <Button x:Name="btnMoveUp" Content="Move Up" Width="84" Height="37" Margin="6,0" Click="btnMoveUp_Click" IsEnabled="False"/>
                        <Button x:Name="btnMoveDown" Content="Move Down" Width="84" Height="37" Margin="6,0" Click="btnMoveDown_Click" IsEnabled="False"/>
                        <Button x:Name="btnRunMerge" Content="Merge" Width="84" Height="37" Margin="6,0" Click="btnRunMerge_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Rotate PDF">
                <Grid Background="#FFE5E5E5" AllowDrop="True" DragOver="tab_DragOver" Drop="rotateTab_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Source File" Margin="26,12,0,2"/>
                    <DockPanel Grid.Row="1" Margin="26,0,26,0">
                        <Button x:Name="btnOpenFileRotate" Content="Select" DockPanel.Dock="Right" Width="72" Height="26" Margin="6,0,0,0" Click="openFileRotate_Click"/>
                        <Label x:Name="lblRotateFileSource" Content="No file selected" Background="White" BorderBrush="#FFABADB3" BorderThickness="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" AllowDrop="True"/>
                    </DockPanel>

                    <Label Grid.Row="2" Content="Pages To Rotate" Margin="26,12,0,2"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="26,0,26,0">
                        <RadioButton x:Name="rbRotateAllPages" Content="All pages" GroupName="RotatePages" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbRotatePageRange" Content="Pages:" GroupName="RotatePages" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtRotatePages" Width="140" Height="26" VerticalContentAlignment="Center" Padding="4,0" IsEnabled="{Binding IsChecked, ElementName=rbRotatePageRange}" ToolTip="Example: 1, 3, 5-7"/>
                        <Label x:Name="lblRotatePageCount" Content="" VerticalContentAlignment="Center" Foreground="Gray" Margin="8,0,0,0" Padding="0"/>
                    </StackPanel>

                    <Label Grid.Row="4" Content="Rotation" Margin="26,12,0,2"/>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="26,0,26,0">
                        <RadioButton x:Name="rbRotate90" Content="90° clockwise" GroupName="RotateAngle" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbRotate180" Content="180°" GroupName="RotateAngle" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbRotate270" Content="90° counter-clockwise" GroupName="RotateAngle" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Label Grid.Row="6" Content="Output File" Margin="26,12,0,2"/>
                    <DockPanel Grid.Row="7" Margin="26,0,26,0" VerticalAlignment="Top">
                        <Button x:Name="btnBrowseRotateOutput" Content="Browse" DockPanel.Dock="Right" Width="72" Height="26" Margin="6,0,0,0" Click="btnBrowseRotateOutput_Click"/>
                        <Label x:Name="lblRotateOutput" Content="" Background="White" BorderBrush="#FFABADB3" BorderThickness="1" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
                    </DockPanel>

                    <Button x:Name="btnRunRotate" Grid.Row="8" Content="Rotate" HorizontalAlignment="Center" Margin="0,0,0,16" Height="37" Width="84" Click="btnRunRotate_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
