                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding HasItems, ElementName=lstBatchFiles, Converter={StaticResource InverseBoolToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="Batch processing" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Rotate, watermark, extract pages from, or add or remove a password on many PDFs at once." Style="{StaticResource PageSubtitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding AddFilesCommand}" Content="Select PDF files" Style="{StaticResource PrimaryButtonLarge}"/>
                                <Button Command="{Binding AddFolderCommand}" Content="Select a folder" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="or drop PDFs or folders here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Visibility="{Binding HasItems, ElementName=lstBatchFiles, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Add files" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}"/>
                                <Button Content="Add folder" Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="FILES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveFilesCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstBatchFiles}"/>
                                <Button Content="Clear list" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFilesCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Files are processed top to bottom. Drop more PDFs or folders to add them." Style="{StaticResource Hint}" TextAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                        <ListBox x:Name="lstBatchFiles" ItemsSource="{Binding Files}" SelectionMode="Extended" Style="{StaticResource FileList}" ItemTemplate="{StaticResource BatchFileTemplate}" AutomationProperties.Name="Files to process"/>
                    </DockPanel>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Progress}" Style="{StaticResource Progress}" Margin="0,8,0,0" AutomationProperties.Name="Batch progress"/>
                                </StackPanel>
                                <Button Command="{Binding RunBatchCommand}">
                                    <Button.Style>
                                        <!-- Content lives in the style so the busy trigger can replace it -->
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Process files"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Content" Value="Processing..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" ToolTip="Stops after the file being processed now"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Batch processing" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="PRESETS" Style="{StaticResource SectionLabel}"/>
                                <Label Content="None yet. Choose the settings below, then name and save them here." Style="{StaticResource HintLabel}" Margin="0,0,0,8"
                                       Visibility="{Binding HasPresets, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource BatchPresetTemplate}" Focusable="False" AutomationProperties.Name="Saved presets">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SavePresetCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Style="{StaticResource Input}"
                                             AutomationProperties.Name="New preset name" ToolTip="A name for the current settings, such as Stamp CONFIDENTIAL"/>
                                </DockPanel>
                                <Label Style="{StaticResource HintLabel}" Content="A preset keeps the action, its options and the output folder. Passwords are never saved."/>

                                <TextBlock Text="ACTION" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="Rotate" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Rotate}" Style="{StaticResource OptionRadio}" GroupName="BatchAction" Margin="0,0,4,8"/>
                                    <RadioButton Content="Watermark" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Watermark}" Style="{StaticResource OptionRadio}" GroupName="BatchAction" Margin="4,0,0,8"/>
                                    <RadioButton Content="Extract pages" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Extract}" Style="{StaticResource OptionRadio}" GroupName="BatchAction" Margin="0,0,4,8"/>
                                    <RadioButton Content="Protect" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Protect}" Style="{StaticResource OptionRadio}" GroupName="BatchAction" Margin="4,0,0,8"/>
                                    <RadioButton Content="Unlock" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Unlock}" Style="{StaticResource OptionRadio}" GroupName="BatchAction" Margin="0,0,4,8"/>
                                </UniformGrid>

                                <!-- Rotate -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Rotate}">
                                    <TextBlock Text="ROTATION" Style="{StaticResource SectionLabel}"/>
                                    <RadioButton Content="90° clockwise" IsChecked="{Binding RotationAngle, Converter={StaticResource RadioValue}, ConverterParameter=90}" Style="{StaticResource OptionRadio}" GroupName="BatchAngle"/>
                                    <RadioButton Content="180°" IsChecked="{Binding RotationAngle, Converter={StaticResource RadioValue}, ConverterParameter=180}" Style="{StaticResource OptionRadio}" GroupName="BatchAngle"/>
                                    <RadioButton Content="90° counter-clockwise" IsChecked="{Binding RotationAngle, Converter={StaticResource RadioValue}, ConverterParameter=270}" Style="{StaticResource OptionRadio}" GroupName="BatchAngle"/>
                                    <Label Style="{StaticResource HintLabel}" Content="Every page of every file is rotated."/>
                                </StackPanel>

                                <!-- Watermark -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Watermark}">
                                    <TextBlock Text="TEXT" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Watermark text" Style="{StaticResource Input}"/>
                                    <TextBlock Text="DIRECTION" Style="{StaticResource SectionLabel}"/>
                                    <UniformGrid Columns="2">
                                        <RadioButton Content="Diagonal" IsChecked="{Binding WatermarkDiagonal, Converter={StaticResource RadioValue}, ConverterParameter=True}" Style="{StaticResource OptionRadio}" GroupName="BatchDirection" Margin="0,0,4,0"/>
                                        <RadioButton Content="Horizontal" IsChecked="{Binding WatermarkDiagonal, Converter={StaticResource RadioValue}, ConverterParameter=False}" Style="{StaticResource OptionRadio}" GroupName="BatchDirection" Margin="4,0,0,0"/>
                                    </UniformGrid>
                                    <TextBlock Text="OPACITY" Style="{StaticResource SectionLabel}"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="Light" IsChecked="{Binding WatermarkOpacity, Converter={StaticResource RadioValue}, ConverterParameter=15}" Style="{StaticResource OptionRadio}" GroupName="BatchOpacity" Margin="0,0,4,0"/>
                                        <RadioButton Content="Medium" IsChecked="{Binding WatermarkOpacity, Converter={StaticResource RadioValue}, ConverterParameter=30}" Style="{StaticResource OptionRadio}" GroupName="BatchOpacity" Margin="2,0,2,0"/>
                                        <RadioButton Content="Strong" IsChecked="{Binding WatermarkOpacity, Converter={StaticResource RadioValue}, ConverterParameter=50}" Style="{StaticResource OptionRadio}" GroupName="BatchOpacity" Margin="4,0,0,0"/>
                                    </UniformGrid>
                                    <Label Style="{StaticResource HintLabel}" Content="The watermark goes on every page of every file."/>
                                </StackPanel>

                                <!-- Extract pages -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Extract}">
                                    <TextBlock Text="PAGES TO EXTRACT" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding PageSpec, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pages to extract from every file" Style="{StaticResource Input}" ToolTip="Example: 1, 3, 5-7"/>
                                    <Label Style="{StaticResource HintLabel}" Content="The same pages are taken from every file. For example, 1 keeps each file's first page."/>
                                </StackPanel>

                                <!-- Protect -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Protect}">
                                    <TextBlock Text="PASSWORD" Style="{StaticResource SectionLabel}"/>
                                    <PasswordBox local:PasswordBinding.Password="{Binding Password}" AutomationProperties.Name="Password for every file" Style="{StaticResource PasswordInput}"/>
                                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource SectionLabel}"/>
                                    <PasswordBox local:PasswordBinding.Password="{Binding ConfirmPassword}" AutomationProperties.Name="Confirm password" Style="{StaticResource PasswordInput}"/>
                                    <Label Style="{StaticResource HintLabel}" Content="Every file gets the same password. It cannot be recovered if it is forgotten."/>
                                </StackPanel>

                                <!-- Unlock -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Unlock}">
                                    <TextBlock Text="PASSWORD" Style="{StaticResource SectionLabel}"/>
                                    <PasswordBox local:PasswordBinding.Password="{Binding Password}" AutomationProperties.Name="Password of the files" Style="{StaticResource PasswordInput}"/>
                                    <Label Style="{StaticResource HintLabel}" Content="The same password is tried on every file. Files it does not open are listed as failed."/>
                                </StackPanel>

                                <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputFolderText}" Style="{StaticResource ValueLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Style="{StaticResource SecondaryButton}"/>
                                    <Button Command="{Binding UseOriginalFoldersCommand}" Content="Use original folders" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Visibility="{Binding HasOutputFolder, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <Label Style="{StaticResource HintLabel}" Content="Each output is named after its file, ending in _rotated, _watermarked and so on. The originals are not changed."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PdfToImageViewModel}">
            <Grid Background="{DynamicResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="pdfToImageTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="PDF to image" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Save pages as PNG or JPEG images, one image per page." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="SELECTED FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{DynamicResource ConvertTileBrush}" Width="40" Height="40" Margin="0,0,14,0">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{DynamicResource ConvertIconBrush}" Width="19" Height="19" Stretch="Uniform" StrokeThickness="2"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Content="Change file" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding OpenFileCommand}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource FileNameConverter}}"/>
                                        <Label Style="{StaticResource PathLabel}" Content="{Binding SourcePath}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Drop another PDF anywhere on this page to replace it." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,12,0,0"/>

                            <TextBlock Text="PAGES" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Click pages to convert only those." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,0,0,12"/>
                            <ContentControl Content="{Binding Thumbnails}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Progress}" Style="{StaticResource Progress}" Margin="0,8,0,0" AutomationProperties.Name="Conversion progress"/>
                                </StackPanel>
                                <Button Command="{Binding RunConvertCommand}">
                                    <Button.Style>
                                        <!-- Content lives in the style so the busy trigger can replace it -->
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Convert to images"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Content" Value="Converting..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" ToolTip="Stops after the page being saved now"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="PDF to image" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="FORMAT" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="PNG" IsChecked="{Binding Format, Converter={StaticResource RadioValue}, ConverterParameter=Png}" Style="{StaticResource OptionRadio}" GroupName="ImageFormat" Margin="0,0,4,0" ToolTip="Sharp text and lines, larger files"/>
                                    <RadioButton Content="JPEG" IsChecked="{Binding Format, Converter={StaticResource RadioValue}, ConverterParameter=Jpeg}" Style="{StaticResource OptionRadio}" GroupName="ImageFormat" Margin="4,0,0,0" ToolTip="Smaller files, best for photos"/>
                                </UniformGrid>

                                <TextBlock Text="RESOLUTION" Style="{StaticResource SectionLabel}"/>
                                <RadioButton Content="72 DPI, for screens" IsChecked="{Binding Dpi, Converter={StaticResource RadioValue}, ConverterParameter=72}" Style="{StaticResource OptionRadio}" GroupName="ImageDpi"/>
                                <RadioButton Content="150 DPI, standard" IsChecked="{Binding Dpi, Converter={StaticResource RadioValue}, ConverterParameter=150}" Style="{StaticResource OptionRadio}" GroupName="ImageDpi"/>
                                <RadioButton Content="300 DPI, for printing" IsChecked="{Binding Dpi, Converter={StaticResource RadioValue}, ConverterParameter=300}" Style="{StaticResource OptionRadio}" GroupName="ImageDpi"/>

                                <TextBlock Text="PAGES" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="All pages" IsChecked="{Binding AllPages, Converter={StaticResource RadioValue}, ConverterParameter=True}" Style="{StaticResource OptionRadio}" GroupName="ImagePages" Margin="0,0,4,8"/>
                                    <RadioButton Content="Specific pages" IsChecked="{Binding AllPages, Converter={StaticResource RadioValue}, ConverterParameter=False}" Style="{StaticResource OptionRadio}" GroupName="ImagePages" Margin="4,0,0,8"/>
                                </UniformGrid>
                                <TextBox Text="{Binding PageSpec, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPageSpecEnabled}" AutomationProperties.Name="Pages to convert" AutomationProperties.HelpText="{Binding PageCountInfo}" Style="{StaticResource Input}" ToolTip="Example: 1, 3, 5-7"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>

                                <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputFolder}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                <Label Style="{StaticResource HintLabel}" Content="Images are named after the file, ending in _page1, _page2 and so on. The folder is created if needed."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImagesToPdfViewModel}">
            <Grid Background="{DynamicResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="imagesToPdfTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding HasItems, ElementName=lstImages, Converter={StaticResource InverseBoolToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Image to PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Turn photos and scans into a PDF, one page per image, in the order you choose." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding AddImagesCommand}" Content="Select images" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop images or a folder here. JPEG, PNG, BMP, GIF and TIFF." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Visibility="{Binding HasItems, ElementName=lstImages, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Add images" Style="{StaticResource SecondaryButton}" Command="{Binding AddImagesCommand}"/>
                            <TextBlock Text="IMAGES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Each image becomes a page, top to bottom. Photos are turned upright using their camera orientation." Style="{StaticResource Hint}" TextAlignment="Left" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <ListBox x:Name="lstImages" ItemsSource="{Binding Images}" SelectionMode="Extended" Style="{StaticResource FileList}" ItemTemplate="{StaticResource ImageItemTemplate}" AutomationProperties.Name="Images to convert"/>
                    </DockPanel>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Button Command="{Binding RunCreateCommand}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Create PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Creating..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Image to PDF" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="ORDER" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstImages}" Content="Move up" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                    <Button Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstImages}" Content="Move down" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <Button Command="{Binding RemoveImagesCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstImages}" Content="Remove selected" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>

                                <TextBlock Text="PAGE SIZE" Style="{StaticResource SectionLabel}"/>
                                <RadioButton Content="Same as each image" IsChecked="{Binding PageSize, Converter={StaticResource RadioValue}, ConverterParameter=SameAsImage}" Style="{StaticResource OptionRadio}" GroupName="ImagePageSize"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="A4" IsChecked="{Binding PageSize, Converter={StaticResource RadioValue}, ConverterParameter=A4}" Style="{StaticResource OptionRadio}" GroupName="ImagePageSize" Margin="0,0,4,0"/>
                                    <RadioButton Content="Letter" IsChecked="{Binding PageSize, Converter={StaticResource RadioValue}, ConverterParameter=Letter}" Style="{StaticResource OptionRadio}" GroupName="ImagePageSize" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <Label Style="{StaticResource HintLabel}" Content="A4 and Letter pages turn to match each image, which is scaled to fit."/>

                                <TextBlock Text="MARGIN" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2" IsEnabled="{Binding CanHaveMargin}">
                                    <RadioButton Content="None" IsChecked="{Binding Margin, Converter={StaticResource RadioValue}, ConverterParameter=False}" Style="{StaticResource OptionRadio}" GroupName="ImageMargin" Margin="0,0,4,0"/>
                                    <RadioButton Content="Half an inch" IsChecked="{Binding Margin, Converter={StaticResource RadioValue}, ConverterParameter=True}" Style="{StaticResource OptionRadio}" GroupName="ImageMargin" Margin="4,0,0,0"/>
                                </UniformGrid>

                                <TextBlock Text="OUTPUT FILE" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,0,16">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Width="13" Height="15" Stretch="Uniform" Stroke="White" StrokeThickness="2"/>
                    </Border>
                    <TextBlock Text="PDF Manager" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="Files never leave this computer." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="22,0,22,20" TextWrapping="Wrap"/>

                <!-- Scrolls when the window is too short for every tool, instead of running into the footer -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <RadioButton x:Name="navHome" AutomationProperties.Name="Tools" Style="{StaticResource NavItem}" GroupName="Nav" Tag="0" IsChecked="True" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconHome}"/>
                                <TextBlock Text="Tools" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <Expander Header="ORGANIZE" Style="{StaticResource NavSection}" IsExpanded="{Binding Sidebar.OrganizeExpanded}" AutomationProperties.Name="Organize tools">
                            <StackPanel>
                                <RadioButton x:Name="navMerge" AutomationProperties.Name="Merge PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="2" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconMerge}"/>
                                        <TextBlock Text="Merge PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navSplit" AutomationProperties.Name="Split PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="1" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconSplit}"/>
                                        <TextBlock Text="Split PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navExtract" AutomationProperties.Name="Extract pages" Style="{StaticResource NavItem}" GroupName="Nav" Tag="4" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconExtract}"/>
                                        <TextBlock Text="Extract pages" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>

                        <Expander Header="EDIT" Style="{StaticResource NavSection}" IsExpanded="{Binding Sidebar.EditExpanded}" AutomationProperties.Name="Edit tools">
                            <StackPanel>
                                <RadioButton x:Name="navRotate" AutomationProperties.Name="Rotate PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="3" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
