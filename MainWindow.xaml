<Window x:Class="PDFManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFManager.ViewModels"
        xmlns:local="clr-namespace:PDFManager"
        mc:Ignorable="d"
        Title="PDF Manager" Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        Icon="app.ico">
    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
        <local:StringVisibilityConverter x:Key="EmptyToVisibility" VisibleWhenEmpty="True"/>
        <local:StringVisibilityConverter x:Key="NotEmptyToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:RadioValueConverter x:Key="RadioValue"/>
        <local:EqualsToVisibilityConverter x:Key="EqualsToVisibility"/>

        <!-- Path label: single line, trimmed with an ellipsis -->
        <Style x:Key="PathLabel" TargetType="Label" BasedOn="{StaticResource ValueLabel}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row template for a file in the merge list -->
        <DataTemplate x:Key="MergeFileTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{DynamicResource FileTileBrush}" Width="38" Height="38" Margin="0,0,14,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{DynamicResource OrganizeIconBrush}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FileName}" Text="{Binding Converter={StaticResource FileNameConverter}}"/>
                    <TextBlock Style="{StaticResource FilePath}" Text="{Binding}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Page thumbnails for a tool's selected file -->
        <DataTemplate DataType="{x:Type vm:PageThumbnailsViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" TextAlignment="Left" Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PageThumbnail}" AutomationProperties.Name="{Binding AccessibleName}"
                                    Command="{Binding DataContext.PageClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Row template for a file in the batch list: name, folder and the outcome of the last run -->
        <DataTemplate x:Key="BatchFileTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{DynamicResource BatchTileBrush}" Width="38" Height="38" Margin="0,0,14,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{DynamicResource BatchIconBrush}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Working">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FileName}" Text="{Binding FileName}"/>
                    <TextBlock Style="{StaticResource FilePath}" Text="{Binding Folder}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Row template for an image in the Image to PDF list: its preview, name and location -->
        <DataTemplate x:Key="ImageItemTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="6" Background="{DynamicResource InputBrush}" Margin="0,0,14,0">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Details}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FileName}" Text="{Binding FileName}"/>
                    <TextBlock Style="{StaticResource FilePath}" Text="{Binding Path}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- A saved Batch preset: its name applies it, the cross deletes it. Highlighted while the
             settings match it -->
        <DataTemplate x:Key="BatchPresetTemplate">
            <Border x:Name="chip" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}" Background="{DynamicResource CardBrush}" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Name}" Style="{StaticResource ChipButton}" Padding="12,6,6,6" ToolTip="Apply these settings"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding ApplyName}"/>
                    <Button Content="×" Style="{StaticResource ChipButton}" Padding="6,6,10,6" ToolTip="Delete this preset"
                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding DeleteName}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26,30,30">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton Content="System" ToolTip="Follow Windows' light or dark app mode" IsChecked="{Binding Appearance.Theme, Converter={StaticResource RadioValue}, ConverterParameter=System}" Style="{StaticResource OptionRadio}" GroupName="Theme" Width="92" Margin="0,0,6,0"/>
                            <RadioButton Content="Light" IsChecked="{Binding Appearance.Theme, Converter={StaticResource RadioValue}, ConverterParameter=Light}" Style="{StaticResource OptionRadio}" GroupName="Theme" Width="92" Margin="0,0,6,0"/>
                            <RadioButton Content="Dark" IsChecked="{Binding Appearance.Theme, Converter={StaticResource RadioValue}, ConverterParameter=Dark}" Style="{StaticResource OptionRadio}" GroupName="Theme" Width="92" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Tools" Style="{StaticResource PageHeading}"/>
                    </DockPanel>

                    <TextBlock Text="Organize PDF" Style="{StaticResource CategoryHeading}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="2" Click="OpenTool_Click" AutomationProperties.Name="Merge PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource OrganizeTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconMerge}" Stroke="{DynamicResource OrganizeIconBrush}"/>
                                </Border>
                                <TextBlock Text="Merge PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="1" Click="OpenTool_Click" AutomationProperties.Name="Split PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource OrganizeTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconSplit}" Stroke="{DynamicResource OrganizeIconBrush}"/>
                                </Border>
                                <TextBlock Text="Split PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="4" Click="OpenTool_Click" AutomationProperties.Name="Extract pages">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource OrganizeTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconExtract}" Stroke="{DynamicResource OrganizeIconBrush}"/>
                                </Border>
                                <TextBlock Text="Extract pages" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Edit PDF" Style="{StaticResource CategoryHeading}" Margin="0,34,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="3" Click="OpenTool_Click" AutomationProperties.Name="Rotate PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource EditTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRotate}" Stroke="{DynamicResource EditIconBrush}"/>
                                </Border>
                                <TextBlock Text="Rotate PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="5" Click="OpenTool_Click" AutomationProperties.Name="Edit metadata">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource EditTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconTag}" Stroke="{DynamicResource EditIconBrush}"/>
                                </Border>
                                <TextBlock Text="Edit metadata" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="8" Click="OpenTool_Click" AutomationProperties.Name="Add watermark">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource EditTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconWatermark}" Stroke="{DynamicResource EditIconBrush}"/>
                                </Border>
                                <TextBlock Text="Add watermark" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="PDF security" Style="{StaticResource CategoryHeading}" Margin="0,34,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="7" Click="OpenTool_Click" AutomationProperties.Name="Unlock PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource SecurityTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconUnlock}" Stroke="{DynamicResource SecurityIconBrush}"/>
                                </Border>
                                <TextBlock Text="Unlock PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="6" Click="OpenTool_Click" AutomationProperties.Name="Protect PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource SecurityTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}" Stroke="{DynamicResource SecurityIconBrush}"/>
                                </Border>
                                <TextBlock Text="Protect PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Convert" Style="{StaticResource CategoryHeading}" Margin="0,34,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="10" Click="OpenTool_Click" AutomationProperties.Name="PDF to image">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource ConvertTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconImage}" Stroke="{DynamicResource ConvertIconBrush}"/>
                                </Border>
                                <TextBlock Text="PDF to image" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="11" Click="OpenTool_Click" AutomationProperties.Name="Image to PDF">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource ConvertTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconImageToPdf}" Stroke="{DynamicResource ConvertIconBrush}"/>
                                </Border>
                                <TextBlock Text="Image to PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Many files at once" Style="{StaticResource CategoryHeading}" Margin="0,34,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="9" Click="OpenTool_Click" AutomationProperties.Name="Batch processing">
                            <StackPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource BatchTileBrush}">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconBatch}" Stroke="{DynamicResource BatchIconBrush}"/>
                                </Border>
                                <TextBlock Text="Batch processing" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SplitViewModel}">
            <Grid Background="{DynamicResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="splitTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Split PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Separate a document into two files after the page you choose." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="SELECTED FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{DynamicResource FileTileBrush}" Width="40" Height="40" Margin="0,0,14,0">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{DynamicResource OrganizeIconBrush}" Width="19" Height="19" Stretch="Uniform" StrokeThickness="2"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Content="Change file" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding OpenFileCommand}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource FileNameConverter}}"/>
                                        <Label Style="{StaticResource PathLabel}" Content="{Binding SourcePath}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Drop another PDF anywhere on this page to replace it." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,12,0,0"/>

                            <TextBlock Text="PAGES" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Click a page to split the document after it." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,0,0,12"/>
                            <ContentControl Content="{Binding Thumbnails}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Button Command="{Binding RunSplitCommand}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Split PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Splitting..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Split PDF" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="SPLIT AFTER PAGE" Style="{StaticResource SectionLabel}"/>
                                <TextBox Text="{Binding SplitPageNum, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Split after page" AutomationProperties.HelpText="{Binding PageCountInfo}" Style="{StaticResource Input}" Width="110" HorizontalAlignment="Left"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>

                                <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputFolder}" Style="{StaticResource ValueLabel}"/>
                                <Label Style="{StaticResource HintLabel}" Content="Two files named after the source, ending in _part1 and _part2, are saved next to it."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExtractViewModel}">
            <Grid Background="{DynamicResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="extractTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Extract pages" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Copy the pages you choose into a new PDF. The original is not changed." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="SELECTED FILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="{DynamicResource FileTileBrush}" Width="40" Height="40" Margin="0,0,14,0">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFile}" Stroke="{DynamicResource OrganizeIconBrush}" Width="19" Height="19" Stretch="Uniform" StrokeThickness="2"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Content="Change file" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding OpenFileCommand}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource FileNameConverter}}"/>
                                        <Label Style="{StaticResource PathLabel}" Content="{Binding SourcePath}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Drop another PDF anywhere on this page to replace it." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,12,0,0"/>

                            <TextBlock Text="PAGES" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Click pages to choose which ones to extract." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,0,0,12"/>
                            <ContentControl Content="{Binding Thumbnails}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Button Command="{Binding RunExtractCommand}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Extract pages"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Extracting..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Extract pages" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="PAGES TO EXTRACT" Style="{StaticResource SectionLabel}"/>
                                <TextBox Text="{Binding PageSpec, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pages to extract" AutomationProperties.HelpText="{Binding PageCountInfo}" Style="{StaticResource Input}" ToolTip="Example: 1, 3, 5-7"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>
                                <Label Style="{StaticResource HintLabel}" Content="Pages keep their original order."/>

                                <TextBlock Text="OUTPUT FILE" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MergeViewModel}">
            <Grid Background="{DynamicResource WindowBrush}" AllowDrop="True" DragOver="tab_DragOver" Drop="mergeTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="28">
                    <Grid Visibility="{Binding HasItems, ElementName=lstMergeFiles, Converter={StaticResource InverseBoolToVisibility}}">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource BorderStrongBrush}" StrokeDashArray="6 4" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Merge PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Combine several PDFs into a single document, in the order you want." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding AddFilesCommand}" Content="Select PDF files" Style="{StaticResource PrimaryButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or drop PDFs here" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Visibility="{Binding HasItems, ElementName=lstMergeFiles, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Add files" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}"/>
                            <TextBlock Text="FILES TO MERGE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Files are merged top to bottom. Drop more PDFs anywhere on this page to add them." Style="{StaticResource Hint}" TextAlignment="Left" Margin="0,4,0,0"/>
                        <ListBox x:Name="lstMergeFiles" ItemsSource="{Binding MergeFiles}" SelectionMode="Extended" Style="{StaticResource FileList}" ItemTemplate="{StaticResource MergeFileTemplate}"/>
                    </DockPanel>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="24,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Button Command="{Binding RunMergeCommand}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Merge PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Merging..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,24,24,16">
                                <TextBlock Text="Merge PDF" Style="{StaticResource SidebarTitle}"/>

                                <TextBlock Text="ORDER" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstMergeFiles}" Content="Move up" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                    <Button Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstMergeFiles}" Content="Move down" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <Button Command="{Binding RemoveFileCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstMergeFiles}" Content="Remove selected" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                                <Label Style="{StaticResource HintLabel}" Content="Select a file in the list to reorder or remove it."/>

                                <TextBlock Text="OUTPUT FILE" Style="{StaticResource SectionLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
