<Window x:Class="PDFManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFManager.ViewModels"
        xmlns:services="clr-namespace:PDFManager.Services"
        xmlns:local="clr-namespace:PDFManager"
        mc:Ignorable="d"
        Title="PDF Manager" Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Icon="app.ico">
    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
        <local:StringVisibilityConverter x:Key="EmptyToVisibility" VisibleWhenEmpty="True"/>
        <local:StringVisibilityConverter x:Key="NotEmptyToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:RadioValueConverter x:Key="RadioValue"/>
        <local:EqualsToVisibilityConverter x:Key="EqualsToVisibility"/>

        <!-- Options are the stock radio buttons, narrow enough for two or three side by side -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Path label: single line, trimmed with an ellipsis -->
        <Style x:Key="PathLabel" TargetType="Label" BasedOn="{StaticResource ValueLabel}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The file a one-PDF tool is working on, with a button to pick another. The DataContext is
             the tool's view model; every one of them has SourcePath and OpenFileCommand -->
        <DataTemplate x:Key="SelectedFileTemplate">
            <StackPanel>
                <TextBlock Text="Selected file" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{StaticResource GlyphPdf}" Style="{StaticResource Icon}" FontSize="28"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0"/>
                        <Button DockPanel.Dock="Right" Content="Change file" Tag="{StaticResource GlyphOpenFile}" Style="{StaticResource IconButton}"
                                VerticalAlignment="Center" Margin="14,0,0,0" Command="{Binding OpenFileCommand}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource FileNameConverter}}"/>
                            <Label Style="{StaticResource PathLabel}" Content="{Binding SourcePath}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="Drop another PDF anywhere on this page to replace it." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- The dashed drop area a tool shows until it has a file -->
        <Style x:Key="DropArea" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="8"/>
            <Setter Property="RadiusY" Value="8"/>
            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
            <Setter Property="StrokeDashArray" Value="4 3"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <Style x:Key="DropAreaIcon" TargetType="TextBlock" BasedOn="{StaticResource CardIcon}">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="DropAreaHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <!-- Row template for a file in the merge list -->
        <DataTemplate x:Key="MergeFileTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{StaticResource GlyphPdf}" Style="{StaticResource Icon}" FontSize="24"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FileName}" Text="{Binding Converter={StaticResource FileNameConverter}}"/>
                    <TextBlock Style="{StaticResource FilePath}" Text="{Binding}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Page thumbnails for a tool's selected file -->
        <DataTemplate DataType="{x:Type vm:PageThumbnailsViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PageThumbnail}" AutomationProperties.Name="{Binding AccessibleName}"
                                    Command="{Binding DataContext.PageClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Row template for a file in the batch list: name, folder and the outcome of the last run -->
        <DataTemplate x:Key="BatchFileTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{StaticResource GlyphPdf}" Style="{StaticResource Icon}" FontSize="24"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Working">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FileName}" Text="{Binding FileName}"/>
                    <TextBlock Style="{StaticResource FilePath}" Text="{Binding Folder}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Row template for an image in the Image to PDF list: its preview, name and location -->
        <DataTemplate x:Key="ImageItemTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="4" Background="White"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,14,0">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Details}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FileName}" Text="{Binding FileName}"/>
                    <TextBlock Style="{StaticResource FilePath}" Text="{Binding Path}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- A saved Batch preset: its name applies it, the cross deletes it. Highlighted while the
             settings match it -->
        <DataTemplate x:Key="BatchPresetTemplate">
            <Border x:Name="chip" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Name}" Style="{StaticResource ChipButton}" Padding="12,5,6,5" ToolTip="Apply these settings"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding ApplyName}"/>
                    <Button Content="×" Style="{StaticResource ChipButton}" Padding="6,5,10,5" ToolTip="Delete this preset"
                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding DeleteName}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,32">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox SelectedValue="{Binding Appearance.Theme}" SelectedValuePath="Tag" Width="210" AutomationProperties.Name="Theme">
                                <ComboBoxItem Content="Use Windows setting" Tag="{x:Static services:AppTheme.System}" ToolTip="Follow Windows' light or dark app mode"/>
                                <ComboBoxItem Content="Light" Tag="{x:Static services:AppTheme.Light}"/>
                                <ComboBoxItem Content="Dark" Tag="{x:Static services:AppTheme.Dark}"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="Tools" Style="{StaticResource PageHeading}"/>
                    </DockPanel>

                    <TextBlock Text="Organize PDF" Style="{StaticResource CategoryHeading}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="2" Click="OpenTool_Click" AutomationProperties.Name="Merge PDF">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphMerge}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Merge PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="1" Click="OpenTool_Click" AutomationProperties.Name="Split PDF">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphSplit}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Split PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="4" Click="OpenTool_Click" AutomationProperties.Name="Extract pages">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphExtract}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Extract pages" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="12" Click="OpenTool_Click" AutomationProperties.Name="Reorder pages">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphReorder}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Reorder pages" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Edit PDF" Style="{StaticResource CategoryHeading}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="3" Click="OpenTool_Click" AutomationProperties.Name="Rotate PDF">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphRotate}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Rotate PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="5" Click="OpenTool_Click" AutomationProperties.Name="Edit metadata">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphTag}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Edit metadata" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="8" Click="OpenTool_Click" AutomationProperties.Name="Add watermark">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphWatermark}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Add watermark" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="PDF security" Style="{StaticResource CategoryHeading}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="7" Click="OpenTool_Click" AutomationProperties.Name="Unlock PDF">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphUnlock}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Unlock PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="6" Click="OpenTool_Click" AutomationProperties.Name="Protect PDF">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphLock}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Protect PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Convert" Style="{StaticResource CategoryHeading}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="10" Click="OpenTool_Click" AutomationProperties.Name="PDF to image">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphImage}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="PDF to image" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Tag="11" Click="OpenTool_Click" AutomationProperties.Name="Image to PDF">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphPdf}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Image to PDF" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Many files at once" Style="{StaticResource CategoryHeading}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Tag="9" Click="OpenTool_Click" AutomationProperties.Name="Batch processing">
                            <StackPanel>
                                <TextBlock Text="{StaticResource GlyphBatch}" Style="{StaticResource CardIcon}"/>
                                <TextBlock Text="Batch processing" Style="{StaticResource CardLabel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SplitViewModel}">
            <Grid Background="Transparent" AllowDrop="True" DragOver="tab_DragOver" Drop="splitTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="24">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle Style="{StaticResource DropArea}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="{StaticResource GlyphSplit}" Style="{StaticResource DropAreaIcon}"/>
                            <TextBlock Text="Split PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Separate a document into two files after the page you choose." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Tag="{StaticResource GlyphOpenFile}" Style="{StaticResource StartButton}"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource DropAreaHint}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SelectedFileTemplate}" Focusable="False"/>

                            <TextBlock Text="Pages" Style="{StaticResource FieldLabel}" Margin="0,22,0,2"/>
                            <TextBlock Text="Click a page to split the document after it." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <ContentControl Content="{Binding Thumbnails}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" BorderThickness="1,0,0,0" Style="{StaticResource SectionPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="16,8,16,16">
                            <Button Command="{Binding RunSplitCommand}" Tag="{StaticResource GlyphSplit}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Split PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Splitting..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,16,16,8">
                                <TextBlock Text="Split PDF" Style="{StaticResource PanelTitle}"/>

                                <TextBlock Text="Split after page" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SplitPageNum, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Split after page" AutomationProperties.HelpText="{Binding PageCountInfo}" Width="110" HorizontalAlignment="Left"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>

                                <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}"/>
                                <Label Content="{Binding OutputFolder}" Style="{StaticResource ValueLabel}"/>
                                <Label Style="{StaticResource HintLabel}" Content="Two files named after the source, ending in _part1 and _part2, are saved next to it."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExtractViewModel}">
            <Grid Background="Transparent" AllowDrop="True" DragOver="tab_DragOver" Drop="extractTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="24">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle Style="{StaticResource DropArea}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="{StaticResource GlyphExtract}" Style="{StaticResource DropAreaIcon}"/>
                            <TextBlock Text="Extract pages" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Copy the pages you choose into a new PDF. The original is not changed." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Tag="{StaticResource GlyphOpenFile}" Style="{StaticResource StartButton}"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource DropAreaHint}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SelectedFileTemplate}" Focusable="False"/>

                            <TextBlock Text="Pages" Style="{StaticResource FieldLabel}" Margin="0,22,0,2"/>
                            <TextBlock Text="Click pages to choose which ones to extract." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <ContentControl Content="{Binding Thumbnails}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" BorderThickness="1,0,0,0" Style="{StaticResource SectionPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="16,8,16,16">
                            <Button Command="{Binding RunExtractCommand}" Tag="{StaticResource GlyphExtract}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Extract pages"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Extracting..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,16,16,8">
                                <TextBlock Text="Extract pages" Style="{StaticResource PanelTitle}"/>

                                <TextBlock Text="Pages to extract" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding PageSpec, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pages to extract" AutomationProperties.HelpText="{Binding PageCountInfo}" ToolTip="Example: 1, 3, 5-7"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>
                                <Label Style="{StaticResource HintLabel}" Content="Pages keep their original order."/>

                                <TextBlock Text="Output file" Style="{StaticResource FieldLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Tag="{StaticResource GlyphFolder}" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReorderViewModel}">
            <Grid Background="Transparent" AllowDrop="True" DragOver="tab_DragOver" Drop="reorderTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="24">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle Style="{StaticResource DropArea}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="{StaticResource GlyphReorder}" Style="{StaticResource DropAreaIcon}"/>
                            <TextBlock Text="Reorder pages" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Put a PDF's pages in a new order and save it as a new file. The original is not changed." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Tag="{StaticResource GlyphOpenFile}" Style="{StaticResource StartButton}"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource DropAreaHint}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}" PreviewDragOver="reorderScroll_PreviewDragOver">
                        <StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SelectedFileTemplate}" Focusable="False"/>

                            <TextBlock Text="Pages" Style="{StaticResource FieldLabel}" Margin="0,22,0,2"/>
                            <TextBlock Text="Drag pages to a new place, or click pages to select them and use the buttons on the right. Each page keeps its original number." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding Thumbnails.StatusText}" Style="{StaticResource Hint}" Visibility="{Binding Thumbnails.StatusText, Converter={StaticResource NotEmptyToVisibility}}"/>
                            <!-- Its own strip rather than the shared one, for dragging pages -->
                            <ItemsControl ItemsSource="{Binding Thumbnails.Pages}" Focusable="False" AutomationProperties.Name="Pages in their new order"
                                          AllowDrop="True" DragOver="reorderStrip_DragOver" DragLeave="reorderStrip_DragLeave" Drop="reorderStrip_Drop">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PageThumbnail}" AutomationProperties.Name="{Binding AccessibleName}"
                                                Command="{Binding DataContext.Thumbnails.PageClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                PreviewMouseLeftButtonDown="reorderPage_PreviewMouseLeftButtonDown" PreviewMouseMove="reorderPage_PreviewMouseMove"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" BorderThickness="1,0,0,0" Style="{StaticResource SectionPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="16,8,16,16">
                            <Button Command="{Binding RunReorderCommand}" Tag="{StaticResource GlyphReorder}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Reorder pages"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Reordering..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,16,16,8">
                                <TextBlock Text="Reorder pages" Style="{StaticResource PanelTitle}"/>

                                <TextBlock Text="Move selected pages" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding MoveToStartCommand}" Content="Move to start" Tag="{StaticResource GlyphFirst}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="0,0,4,8"/>
                                    <Button Command="{Binding MoveToEndCommand}" Content="Move to end" Tag="{StaticResource GlyphLast}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="4,0,0,8"/>
                                    <Button Command="{Binding MoveEarlierCommand}" Content="Move earlier" Tag="{StaticResource GlyphPrevious}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <Button Command="{Binding MoveLaterCommand}" Content="Move later" Tag="{StaticResource GlyphNext}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <Label Style="{StaticResource HintLabel}" Content="Selected pages move together."/>

                                <TextBlock Text="All pages" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding ReverseCommand}" Content="Reverse order" Tag="{StaticResource GlyphReorder}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <Button Command="{Binding ResetOrderCommand}" Content="Reset order" Tag="{StaticResource GlyphReset}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </UniformGrid>

                                <TextBlock Text="Order" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding OrderSummary}" TextWrapping="Wrap" AutomationProperties.Name="Page order"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>

                                <TextBlock Text="Output file" Style="{StaticResource FieldLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
