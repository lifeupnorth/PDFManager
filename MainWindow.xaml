                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Remove selected" Tag="{StaticResource GlyphDelete}" Style="{StaticResource IconButton}" Command="{Binding RemoveFilesCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstBatchFiles}"/>
                                <Button Content="Clear list" Tag="{StaticResource GlyphClear}" Style="{StaticResource IconButton}" Command="{Binding ClearFilesCommand}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Files are processed top to bottom. Drop more PDFs or folders to add them." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </DockPanel>
                        <ListBox x:Name="lstBatchFiles" ItemsSource="{Binding Files}" SelectionMode="Extended" Style="{StaticResource FileList}" ItemTemplate="{StaticResource BatchFileTemplate}" AutomationProperties.Name="Files to process"/>
                    </DockPanel>
                </Grid>

                <Border Grid.Column="1" BorderThickness="1,0,0,0" Style="{StaticResource SectionPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="16,8,16,16">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Margin="0,8,0,0" AutomationProperties.Name="Batch progress"/>
                                </StackPanel>
                                <Button Command="{Binding RunBatchCommand}" Tag="{StaticResource GlyphBatch}">
                                    <Button.Style>
                                        <!-- Content lives in the style so the busy trigger can replace it -->
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Process files"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Content" Value="Processing..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Cancel" Tag="{StaticResource GlyphCancel}" Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Padding="0,8" Margin="0,8,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" ToolTip="Stops after the file being processed now"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,16,16,8">
                                <TextBlock Text="Batch processing" Style="{StaticResource PanelTitle}"/>

                                <TextBlock Text="Presets" Style="{StaticResource FieldLabel}"/>
                                <Label Content="None yet. Choose the settings below, then name and save them here." Style="{StaticResource HintLabel}" Margin="0,0,0,8"
                                       Visibility="{Binding HasPresets, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource BatchPresetTemplate}" Focusable="False" AutomationProperties.Name="Saved presets">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Content="Save" Tag="{StaticResource GlyphSave}" Command="{Binding SavePresetCommand}" Style="{StaticResource IconButton}" Margin="6,0,0,0"/>
                                    <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                             AutomationProperties.Name="New preset name" ToolTip="A name for the current settings, such as Stamp CONFIDENTIAL"/>
                                </DockPanel>
                                <Label Style="{StaticResource HintLabel}" Content="A preset keeps the action, its options and the output folder. Passwords are never saved."/>

                                <TextBlock Text="Action" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="Rotate" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Rotate}" GroupName="BatchAction"/>
                                    <RadioButton Content="Watermark" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Watermark}" GroupName="BatchAction"/>
                                    <RadioButton Content="Extract pages" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Extract}" GroupName="BatchAction"/>
                                    <RadioButton Content="Protect" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Protect}" GroupName="BatchAction"/>
                                    <RadioButton Content="Unlock" IsChecked="{Binding Action, Converter={StaticResource RadioValue}, ConverterParameter=Unlock}" GroupName="BatchAction"/>
                                </UniformGrid>

                                <!-- Rotate -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Rotate}">
                                    <TextBlock Text="Rotation" Style="{StaticResource FieldLabel}"/>
                                    <RadioButton Content="90° clockwise" IsChecked="{Binding RotationAngle, Converter={StaticResource RadioValue}, ConverterParameter=90}" GroupName="BatchAngle"/>
                                    <RadioButton Content="180°" IsChecked="{Binding RotationAngle, Converter={StaticResource RadioValue}, ConverterParameter=180}" GroupName="BatchAngle"/>
                                    <RadioButton Content="90° counter-clockwise" IsChecked="{Binding RotationAngle, Converter={StaticResource RadioValue}, ConverterParameter=270}" GroupName="BatchAngle"/>
                                    <Label Style="{StaticResource HintLabel}" Content="Every page of every file is rotated."/>
                                </StackPanel>

                                <!-- Watermark -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Watermark}">
                                    <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Watermark text"/>
                                    <TextBlock Text="Direction" Style="{StaticResource FieldLabel}"/>
                                    <UniformGrid Columns="2">
                                        <RadioButton Content="Diagonal" IsChecked="{Binding WatermarkDiagonal, Converter={StaticResource RadioValue}, ConverterParameter=True}" GroupName="BatchDirection"/>
                                        <RadioButton Content="Horizontal" IsChecked="{Binding WatermarkDiagonal, Converter={StaticResource RadioValue}, ConverterParameter=False}" GroupName="BatchDirection"/>
                                    </UniformGrid>
                                    <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="Light" IsChecked="{Binding WatermarkOpacity, Converter={StaticResource RadioValue}, ConverterParameter=15}" GroupName="BatchOpacity"/>
                                        <RadioButton Content="Medium" IsChecked="{Binding WatermarkOpacity, Converter={StaticResource RadioValue}, ConverterParameter=30}" GroupName="BatchOpacity"/>
                                        <RadioButton Content="Strong" IsChecked="{Binding WatermarkOpacity, Converter={StaticResource RadioValue}, ConverterParameter=50}" GroupName="BatchOpacity"/>
                                    </UniformGrid>
                                    <Label Style="{StaticResource HintLabel}" Content="The watermark goes on every page of every file."/>
                                </StackPanel>

                                <!-- Extract pages -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Extract}">
                                    <TextBlock Text="Pages to extract" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding PageSpec, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pages to extract from every file" ToolTip="Example: 1, 3, 5-7"/>
                                    <Label Style="{StaticResource HintLabel}" Content="The same pages are taken from every file. For example, 1 keeps each file's first page."/>
                                </StackPanel>

                                <!-- Protect -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Protect}">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox local:PasswordBinding.Password="{Binding Password}" AutomationProperties.Name="Password for every file"/>
                                    <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox local:PasswordBinding.Password="{Binding ConfirmPassword}" AutomationProperties.Name="Confirm password"/>
                                    <Label Style="{StaticResource HintLabel}" Content="Every file gets the same password. It cannot be recovered if it is forgotten."/>
                                </StackPanel>

                                <!-- Unlock -->
                                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Unlock}">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox local:PasswordBinding.Password="{Binding Password}" AutomationProperties.Name="Password of the files"/>
                                    <Label Style="{StaticResource HintLabel}" Content="The same password is tried on every file. Files it does not open are listed as failed."/>
                                </StackPanel>

                                <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}"/>
                                <Label Content="{Binding OutputFolderText}" Style="{StaticResource ValueLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Tag="{StaticResource GlyphFolder}" Style="{StaticResource IconButton}"/>
                                    <Button Command="{Binding UseOriginalFoldersCommand}" Content="Use original folders" Margin="6,0,0,0"
                                            Visibility="{Binding HasOutputFolder, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <Label Style="{StaticResource HintLabel}" Content="Each output is named after its file, ending in _rotated, _watermarked and so on. The originals are not changed."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PdfToImageViewModel}">
            <Grid Background="Transparent" AllowDrop="True" DragOver="tab_DragOver" Drop="pdfToImageTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="24">
                    <Grid Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                        <Rectangle Style="{StaticResource DropArea}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="{StaticResource GlyphImage}" Style="{StaticResource DropAreaIcon}"/>
                            <TextBlock Text="PDF to image" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Save pages as PNG or JPEG images, one image per page." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding OpenFileCommand}" Content="Select PDF file" Tag="{StaticResource GlyphOpenFile}" Style="{StaticResource StartButton}"/>
                            <TextBlock Text="or drop a PDF here" Style="{StaticResource DropAreaHint}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SourcePath, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SelectedFileTemplate}" Focusable="False"/>

                            <TextBlock Text="Pages" Style="{StaticResource FieldLabel}" Margin="0,22,0,2"/>
                            <TextBlock Text="Click pages to convert only those." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <ContentControl Content="{Binding Thumbnails}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" BorderThickness="1,0,0,0" Style="{StaticResource SectionPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="16,8,16,16">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Margin="0,8,0,0" AutomationProperties.Name="Conversion progress"/>
                                </StackPanel>
                                <Button Command="{Binding RunConvertCommand}" Tag="{StaticResource GlyphImage}">
                                    <Button.Style>
                                        <!-- Content lives in the style so the busy trigger can replace it -->
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Convert to images"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Content" Value="Converting..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Cancel" Tag="{StaticResource GlyphCancel}" Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Padding="0,8" Margin="0,8,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" ToolTip="Stops after the page being saved now"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,16,16,8">
                                <TextBlock Text="PDF to image" Style="{StaticResource PanelTitle}"/>

                                <TextBlock Text="Format" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="PNG" IsChecked="{Binding Format, Converter={StaticResource RadioValue}, ConverterParameter=Png}" GroupName="ImageFormat" ToolTip="Sharp text and lines, larger files"/>
                                    <RadioButton Content="JPEG" IsChecked="{Binding Format, Converter={StaticResource RadioValue}, ConverterParameter=Jpeg}" GroupName="ImageFormat" ToolTip="Smaller files, best for photos"/>
                                </UniformGrid>

                                <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}"/>
                                <RadioButton Content="72 DPI, for screens" IsChecked="{Binding Dpi, Converter={StaticResource RadioValue}, ConverterParameter=72}" GroupName="ImageDpi"/>
                                <RadioButton Content="150 DPI, standard" IsChecked="{Binding Dpi, Converter={StaticResource RadioValue}, ConverterParameter=150}" GroupName="ImageDpi"/>
                                <RadioButton Content="300 DPI, for printing" IsChecked="{Binding Dpi, Converter={StaticResource RadioValue}, ConverterParameter=300}" GroupName="ImageDpi"/>

                                <TextBlock Text="Pages" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="All pages" IsChecked="{Binding AllPages, Converter={StaticResource RadioValue}, ConverterParameter=True}" GroupName="ImagePages"/>
                                    <RadioButton Content="Specific pages" IsChecked="{Binding AllPages, Converter={StaticResource RadioValue}, ConverterParameter=False}" GroupName="ImagePages"/>
                                </UniformGrid>
                                <TextBox Text="{Binding PageSpec, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPageSpecEnabled}" AutomationProperties.Name="Pages to convert" AutomationProperties.HelpText="{Binding PageCountInfo}" ToolTip="Example: 1, 3, 5-7" Margin="0,4,0,0"/>
                                <Label Content="{Binding PageCountInfo}" Style="{StaticResource HintLabel}"/>

                                <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}"/>
                                <Label Content="{Binding OutputFolder}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Tag="{StaticResource GlyphFolder}" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <Label Style="{StaticResource HintLabel}" Content="Images are named after the file, ending in _page1, _page2 and so on. The folder is created if needed."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ImagesToPdfViewModel}">
            <Grid Background="Transparent" AllowDrop="True" DragOver="tab_DragOver" Drop="imagesToPdfTab_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="24">
                    <Grid Visibility="{Binding HasItems, ElementName=lstImages, Converter={StaticResource InverseBoolToVisibility}}">
                        <Rectangle Style="{StaticResource DropArea}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="{StaticResource GlyphPdf}" Style="{StaticResource DropAreaIcon}"/>
                            <TextBlock Text="Image to PDF" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Turn photos and scans into a PDF, one page per image, in the order you choose." Style="{StaticResource PageSubtitle}"/>
                            <Button Command="{Binding AddImagesCommand}" Content="Select images" Tag="{StaticResource GlyphOpenFile}" Style="{StaticResource StartButton}"/>
                            <TextBlock Text="or drop images or a folder here. JPEG, PNG, BMP, GIF and TIFF." Style="{StaticResource DropAreaHint}"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Visibility="{Binding HasItems, ElementName=lstImages, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Add images" Tag="{StaticResource GlyphAdd}" Style="{StaticResource IconButton}" Command="{Binding AddImagesCommand}"/>
                            <TextBlock Text="Images" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Each image becomes a page, top to bottom. Photos are turned upright using their camera orientation." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <ListBox x:Name="lstImages" ItemsSource="{Binding Images}" SelectionMode="Extended" Style="{StaticResource FileList}" ItemTemplate="{StaticResource ImageItemTemplate}" AutomationProperties.Name="Images to convert"/>
                    </DockPanel>
                </Grid>

                <Border Grid.Column="1" BorderThickness="1,0,0,0" Style="{StaticResource SectionPanel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Padding="16,8,16,16">
                            <Button Command="{Binding RunCreateCommand}" Tag="{StaticResource GlyphPdf}">
                                <Button.Style>
                                    <!-- Content lives in the style so the busy trigger can replace it -->
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Create PDF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Creating..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,16,16,8">
                                <TextBlock Text="Image to PDF" Style="{StaticResource PanelTitle}"/>

                                <TextBlock Text="Order" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstImages}" Content="Move up" Tag="{StaticResource GlyphUp}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <Button Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstImages}" Content="Move down" Tag="{StaticResource GlyphDown}" Style="{StaticResource IconButton}" HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <Button Command="{Binding RemoveImagesCommand}" CommandParameter="{Binding SelectedItems, ElementName=lstImages}" Content="Remove selected" Tag="{StaticResource GlyphDelete}" Style="{StaticResource IconButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>

                                <TextBlock Text="Page size" Style="{StaticResource FieldLabel}"/>
                                <RadioButton Content="Same as each image" IsChecked="{Binding PageSize, Converter={StaticResource RadioValue}, ConverterParameter=SameAsImage}" GroupName="ImagePageSize"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Content="A4" IsChecked="{Binding PageSize, Converter={StaticResource RadioValue}, ConverterParameter=A4}" GroupName="ImagePageSize"/>
                                    <RadioButton Content="Letter" IsChecked="{Binding PageSize, Converter={StaticResource RadioValue}, ConverterParameter=Letter}" GroupName="ImagePageSize"/>
                                </UniformGrid>
                                <Label Style="{StaticResource HintLabel}" Content="A4 and Letter pages turn to match each image, which is scaled to fit."/>

                                <TextBlock Text="Margin" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2" IsEnabled="{Binding CanHaveMargin}">
                                    <RadioButton Content="None" IsChecked="{Binding Margin, Converter={StaticResource RadioValue}, ConverterParameter=False}" GroupName="ImageMargin"/>
                                    <RadioButton Content="Half an inch" IsChecked="{Binding Margin, Converter={StaticResource RadioValue}, ConverterParameter=True}" GroupName="ImageMargin"/>
                                </UniformGrid>

                                <TextBlock Text="Output file" Style="{StaticResource FieldLabel}"/>
                                <Label Content="{Binding OutputPath}" Style="{StaticResource ValueLabel}"/>
                                <Button Command="{Binding BrowseOutputCommand}" Content="Browse" Tag="{StaticResource GlyphFolder}" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderThickness="0,0,1,0" Style="{StaticResource SectionPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,14,0,8">
                    <Image Source="app.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PDF Manager" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="Files never leave this computer." Style="{StaticResource Hint}" Margin="20,8,20,16"/>

                <!-- Scrolls when the window is too short for every tool, instead of running into the footer -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <RadioButton x:Name="navHome" AutomationProperties.Name="Tools" Style="{StaticResource NavItem}" GroupName="Nav" Tag="0" IsChecked="True" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphHome}"/>
                                <TextBlock Text="Tools" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <Expander Header="Organize" Style="{StaticResource NavSection}" IsExpanded="{Binding Sidebar.OrganizeExpanded}" AutomationProperties.Name="Organize tools">
                            <StackPanel>
                                <RadioButton x:Name="navMerge" AutomationProperties.Name="Merge PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="2" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphMerge}"/>
                                        <TextBlock Text="Merge PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navSplit" AutomationProperties.Name="Split PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="1" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphSplit}"/>
                                        <TextBlock Text="Split PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navExtract" AutomationProperties.Name="Extract pages" Style="{StaticResource NavItem}" GroupName="Nav" Tag="4" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphExtract}"/>
                                        <TextBlock Text="Extract pages" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navReorder" AutomationProperties.Name="Reorder pages" Style="{StaticResource NavItem}" GroupName="Nav" Tag="12" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphReorder}"/>
                                        <TextBlock Text="Reorder pages" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Edit" Style="{StaticResource NavSection}" IsExpanded="{Binding Sidebar.EditExpanded}" AutomationProperties.Name="Edit tools">
                            <StackPanel>
                                <RadioButton x:Name="navRotate" AutomationProperties.Name="Rotate PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="3" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphRotate}"/>
                                        <TextBlock Text="Rotate PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navMetadata" AutomationProperties.Name="Edit metadata" Style="{StaticResource NavItem}" GroupName="Nav" Tag="5" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphTag}"/>
                                        <TextBlock Text="Edit metadata" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navWatermark" AutomationProperties.Name="Add watermark" Style="{StaticResource NavItem}" GroupName="Nav" Tag="8" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphWatermark}"/>
                                        <TextBlock Text="Add watermark" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Security" Style="{StaticResource NavSection}" IsExpanded="{Binding Sidebar.SecurityExpanded}" AutomationProperties.Name="Security tools">
                            <StackPanel>
                                <RadioButton x:Name="navUnlock" AutomationProperties.Name="Unlock PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="7" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphUnlock}"/>
                                        <TextBlock Text="Unlock PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navProtect" AutomationProperties.Name="Protect PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="6" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphLock}"/>
                                        <TextBlock Text="Protect PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Convert" Style="{StaticResource NavSection}" IsExpanded="{Binding Sidebar.ConvertExpanded}" AutomationProperties.Name="Convert tools">
                            <StackPanel>
                                <RadioButton x:Name="navPdfToImage" AutomationProperties.Name="PDF to image" Style="{StaticResource NavItem}" GroupName="Nav" Tag="10" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphImage}"/>
                                        <TextBlock Text="PDF to image" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="navImagesToPdf" AutomationProperties.Name="Image to PDF" Style="{StaticResource NavItem}" GroupName="Nav" Tag="11" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphPdf}"/>
                                        <TextBlock Text="Image to PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Batch" Style="{StaticResource NavSection}" IsExpanded="{Binding Sidebar.BatchExpanded}" AutomationProperties.Name="Batch tools">
                            <StackPanel>
                                <RadioButton x:Name="navBatch" AutomationProperties.Name="Batch processing" Style="{StaticResource NavItem}" GroupName="Nav" Tag="9" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource NavIcon}" Text="{StaticResource GlyphBatch}"/>
                                        <TextBlock Text="Batch processing" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Shows the selected tool; the view comes from the DataTemplate for its view model -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Focusable="False"/>
    </Grid>
</Window>
