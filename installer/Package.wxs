<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- The version comes from PDFManager.exe, so it is set in PDFManager.csproj only.
       Keep the UpgradeCode: a new version finds the old one by it and replaces it. -->
  <Package Name="PDF Manager"
           Manufacturer="Alexey Kuprienko"
           Version="!(bind.FileVersion.PDFManagerExe)"
           UpgradeCode="ADE5BC72-E2D1-4D28-B459-6CFDF724D709"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- The exe carries app.ico; an advertised shortcut needs its icon from the same .exe -->
    <Icon Id="PDFManager.exe" SourceFile="$(var.AppPublishDir)PDFManager.exe" />
    <Property Id="ARPPRODUCTICON" Value="PDFManager.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PDF Manager" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="PDFManagerExe" Source="$(var.AppPublishDir)PDFManager.exe" KeyPath="yes">
          <Shortcut Name="PDF Manager" Directory="ProgramMenuFolder" WorkingDirectory="INSTALLFOLDER"
                    Icon="PDFManager.exe" Advertise="yes" />
        </File>
      </Component>
      <!-- Everything else the self-contained publish produced: the .NET runtime, WPF and iText -->
      <Files Include="$(var.AppPublishDir)**">
        <Exclude Files="$(var.AppPublishDir)PDFManager.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- Welcome, install folder, install, finish; there is no license page because the app has no license text -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- "Launch PDF Manager" on the last page, ticked by default -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch PDF Manager" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PDFManagerExe]" />
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />

  </Package>
</Wix>
