<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!-- Dark palette. Light.xaml must define the same keys; a test checks that, and that the
         text colours meet WCAG AA contrast against the backgrounds they are used on -->

    <SolidColorBrush x:Key="AccentBrush" Color="#E5322D" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0443F" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C4261F" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#6B2F2D" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#3A2424" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryDisabledTextBrush" Color="#B99C9B" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7A75" po:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CC08B" po:Freeze="True"/>

    <SolidColorBrush x:Key="WindowBrush" Color="#1C1C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#1C1C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#242424" po:Freeze="True"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#232323" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2A2A2A" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#343434" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1F1F1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#333333" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A4A4A" po:Freeze="True"/>
    <!-- Text and password boxes: their border is what shows where to type, so it gets
         at least 3:1 against the box and everything around it -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#76767E" po:Freeze="True"/>
    <SolidColorBrush x:Key="ThumbnailFrameBrush" Color="#2A2A2A" po:Freeze="True"/>
    <!-- The page shown in the watermark preview -->
    <SolidColorBrush x:Key="PaperBrush" Color="#F4F4F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaperBorderBrush" Color="#F4F4F4" po:Freeze="True"/>

    <!-- Scroll bar thumb: at least 3:1 against every background it scrolls -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#73737C" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8E8E98" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#A6A6AE" po:Freeze="True"/>

    <SolidColorBrush x:Key="TextBrush" Color="#EAEAEA" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6AE" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E98" po:Freeze="True"/>

    <!-- Icon tile tints, matching the reference app's category colours -->
    <SolidColorBrush x:Key="OrganizeTileBrush" Color="#F4C3BF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OrganizeIconBrush" Color="#C43F39" po:Freeze="True"/>
    <SolidColorBrush x:Key="EditTileBrush" Color="#DAD3F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="EditIconBrush" Color="#6A53C4" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecurityTileBrush" Color="#C8DCF3" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecurityIconBrush" Color="#2F67B2" po:Freeze="True"/>
    <SolidColorBrush x:Key="BatchTileBrush" Color="#CBE8D5" po:Freeze="True"/>
    <SolidColorBrush x:Key="BatchIconBrush" Color="#2E8B57" po:Freeze="True"/>
    <SolidColorBrush x:Key="ConvertTileBrush" Color="#F5E2B3" po:Freeze="True"/>
    <SolidColorBrush x:Key="ConvertIconBrush" Color="#96670C" po:Freeze="True"/>
    <SolidColorBrush x:Key="FileTileBrush" Color="#F4C3BF" po:Freeze="True"/>
</ResourceDictionary>
