<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!-- Light palette. Dark.xaml must define the same keys; a test checks that, and that the
         text colours meet WCAG AA contrast against the backgrounds they are used on -->

    <SolidColorBrush x:Key="AccentBrush" Color="#E5322D" po:Freeze="True"/>
    <!-- On a light background the hover and pressed states darken rather than lighten -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C8231F" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#A81D1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#F0A9A6" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#FCE9E8" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryDisabledTextBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C8231F" po:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7A45" po:Freeze="True"/>

    <SolidColorBrush x:Key="WindowBrush" Color="#F5F5F7" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#ECECF0" po:Freeze="True"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E1E1E7" po:Freeze="True"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F0F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E1E7" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#8A8A94" po:Freeze="True"/>
    <!-- Pages are white, so their thumbnails need a grey frame to stand out from white cards -->
    <SolidColorBrush x:Key="ThumbnailFrameBrush" Color="#E6E6EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaperBorderBrush" Color="#D5D5DC" po:Freeze="True"/>

    <SolidColorBrush x:Key="TextBrush" Color="#1C1C1E" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#55555E" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#66666F" po:Freeze="True"/>

    <!-- Icon tile tints, the same as the dark theme's: they are pale enough for both -->
    <SolidColorBrush x:Key="OrganizeTileBrush" Color="#F4C3BF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OrganizeIconBrush" Color="#C43F39" po:Freeze="True"/>
    <SolidColorBrush x:Key="EditTileBrush" Color="#DAD3F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="EditIconBrush" Color="#6A53C4" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecurityTileBrush" Color="#C8DCF3" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecurityIconBrush" Color="#2F67B2" po:Freeze="True"/>
    <SolidColorBrush x:Key="BatchTileBrush" Color="#CBE8D5" po:Freeze="True"/>
    <SolidColorBrush x:Key="BatchIconBrush" Color="#2E8B57" po:Freeze="True"/>
    <SolidColorBrush x:Key="ConvertTileBrush" Color="#F5E2B3" po:Freeze="True"/>
    <SolidColorBrush x:Key="ConvertIconBrush" Color="#96670C" po:Freeze="True"/>
    <SolidColorBrush x:Key="FileTileBrush" Color="#F4C3BF" po:Freeze="True"/>
</ResourceDictionary>
