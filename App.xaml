<Application x:Class="PDFManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PDFManager"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- WPF's Fluent theme, as in ScanManager: the stock controls, the Windows accent colour and
                 Mica. ThemeManager sets Application.ThemeMode, which swaps this dictionary for its light or
                 dark version, so every colour below is a DynamicResource to one of the theme's brushes -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Icon glyphs from Segoe Fluent Icons -->
            <sys:String x:Key="GlyphHome">&#xE80F;</sys:String>
            <sys:String x:Key="GlyphMerge">&#xEA3C;</sys:String>
            <sys:String x:Key="GlyphSplit">&#xE8C6;</sys:String>
            <sys:String x:Key="GlyphExtract">&#xEDE1;</sys:String>
            <sys:String x:Key="GlyphReorder">&#xE8CB;</sys:String>
            <sys:String x:Key="GlyphRotate">&#xE7AD;</sys:String>
            <sys:String x:Key="GlyphTag">&#xE8EC;</sys:String>
            <sys:String x:Key="GlyphWatermark">&#xE8D2;</sys:String>
            <sys:String x:Key="GlyphUnlock">&#xE785;</sys:String>
            <sys:String x:Key="GlyphLock">&#xE72E;</sys:String>
            <sys:String x:Key="GlyphImage">&#xEB9F;</sys:String>
            <sys:String x:Key="GlyphPdf">&#xEA90;</sys:String>
            <sys:String x:Key="GlyphBatch">&#xE8F1;</sys:String>
            <sys:String x:Key="GlyphOpenFile">&#xE8E5;</sys:String>
            <sys:String x:Key="GlyphAdd">&#xE710;</sys:String>
            <sys:String x:Key="GlyphAddFolder">&#xE8F4;</sys:String>
            <sys:String x:Key="GlyphChevron">&#xE70D;</sys:String>
            <sys:String x:Key="GlyphCheck">&#xE73E;</sys:String>
            <sys:String x:Key="GlyphFolder">&#xE838;</sys:String>
            <sys:String x:Key="GlyphDelete">&#xE74D;</sys:String>
            <sys:String x:Key="GlyphClear">&#xE894;</sys:String>
            <sys:String x:Key="GlyphUp">&#xE74A;</sys:String>
            <sys:String x:Key="GlyphDown">&#xE74B;</sys:String>
            <sys:String x:Key="GlyphFirst">&#xE892;</sys:String>
            <sys:String x:Key="GlyphLast">&#xE893;</sys:String>
            <sys:String x:Key="GlyphPrevious">&#xE76B;</sys:String>
            <sys:String x:Key="GlyphNext">&#xE76C;</sys:String>
            <sys:String x:Key="GlyphReset">&#xE777;</sys:String>
            <sys:String x:Key="GlyphCancel">&#xE711;</sys:String>
            <sys:String x:Key="GlyphSave">&#xE74E;</sys:String>

            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Buttons with an icon before their text, as ScanManager's: the glyph goes in Tag and the
                 text stays the Content, so it is still the button's accessible name -->
            <DataTemplate x:Key="IconAndText">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="ContentTemplate" Value="{StaticResource IconAndText}"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource IconAndText}"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <!-- "Select PDF file" on a tool's empty page -->
            <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource AccentIconButton}">
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- The panels either side of the content, as ScanManager's side panels and command bar -->
            <Style x:Key="SectionPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <!-- A raised area inside the content, such as the selected file -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>

            <!-- The button that runs a tool: the accent button, filling the panel's width -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentIconButton}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0,8"/>
            </Style>

            <!-- Left navigation item, drawn like a Fluent NavigationView item -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <!-- Compact enough for every tool to fit the sidebar at the default window height
                     (32 px: 13 tools fit at 1100x720; the harness step sidebar_fits checks) -->
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Margin="6,0" Height="32" SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="indicator" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            HorizontalAlignment="Left" Visibility="Collapsed"/>
                                    <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <!-- A collapsible sidebar section: a heading that toggles the tools below it. Expander gives
                 screen readers the expanded/collapsed state and keyboard support for free -->
            <Style x:Key="NavSection" TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Foreground="{TemplateBinding Foreground}" FocusVisualStyle="{x:Null}" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="4" Margin="6,8,6,0" Padding="14,6,10,6">
                                                <DockPanel>
                                                    <TextBlock x:Name="chevron" DockPanel.Dock="Right" Text="{StaticResource GlyphChevron}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                               VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="-90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" FontSize="12" FontWeight="SemiBold"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="items" Visibility="Collapsed"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="items" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tool card on the home screen -->
            <Style x:Key="ToolCard" TargetType="Button">
                <Setter Property="Width" Value="128"/>
                <Setter Property="Height" Value="112"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            </Style>

            <!-- A text-only button inside a preset chip: the preset's name, or its delete cross -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A page thumbnail: a click is passed to the tool, which selects the page or splits after it.
                 The DataContext is a PageThumbnail. Pages are drawn on white, as ScanManager's are -->
            <Style x:Key="PageThumbnail" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Margin" Value="0,0,16,14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Width="120">
                                <Grid>
                                    <Border x:Name="frame" Height="160" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="2" Padding="6">
                                        <Grid>
                                            <TextBlock Text="{Binding PageNumber}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <RotateTransform Angle="{Binding PreviewRotation}"/>
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="check" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed">
                                        <TextBlock Text="{StaticResource GlyphCheck}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Split marker, in the gap after the page -->
                                    <Border x:Name="split" Width="4" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" Margin="0,6,-10,6" Visibility="Collapsed"/>
                                    <!-- Reorder's drop markers, in the gap before or after the page -->
                                    <Border x:Name="dropBefore" Width="4" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/>
                                    <Border x:Name="dropAfter" Width="4" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" Margin="0,0,-10,0" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSplitAfter}" Value="True">
                                    <Setter TargetName="split" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DropMarker}" Value="Before">
                                    <Setter TargetName="dropBefore" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DropMarker}" Value="After">
                                    <Setter TargetName="dropAfter" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Read-only value shown in the options panel (file paths, folders) -->
            <Style x:Key="ValueLabel" TargetType="Label">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HintLabel" TargetType="Label" BasedOn="{StaticResource ValueLabel}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <!-- Typography, following ScanManager: a semibold caption above each setting -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,14,0,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="PageHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="CategoryHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,22,0,10"/>
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,10,0,26"/>
            </Style>

            <Style x:Key="CardLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,12,0,0"/>
            </Style>

            <Style x:Key="FileName" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="FilePath" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>

            <!-- Secondary text, as ScanManager's Hint -->
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- File lists (Merge, Batch, Image to PDF): the stock list items, a little taller -->
            <Style x:Key="FileList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="ToolTip" Value="{Binding}"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
