<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 APIs for Windows.Data.Pdf, which renders page thumbnails; it needs 1809 or later -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico"/>
  </ItemGroup>

  <!-- The test and tool projects live below this folder; keep their sources out of the app -->
  <ItemGroup>
    <Compile Remove="PDFManager.Tests\**;tools\**" />
    <None Remove="PDFManager.Tests\**;tools\**" />
    <Page Remove="PDFManager.Tests\**;tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.7.0" />
  </ItemGroup>

</Project>
